# Copy this file to `creds.env` in this directory and fill in your own values.
# The notebooks load `creds.env` automatically, so you do not have to edit them.

# Neo4j database connection, used by neo4j-example.ipynb and gds-example.ipynb
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DB=neo4j

# Aura Graph Analytics, optionally used by gds-example.ipynb to run GDS in Aura
# instead of a local Neo4j instance with the GDS plugin.
AURA_INSTANCEID=
AURA_API_CLIENT_ID=
AURA_API_CLIENT_SECRET=
AURA_API_PROJECT_ID=

# Snowflake connection, used by snowflake-example.ipynb
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
