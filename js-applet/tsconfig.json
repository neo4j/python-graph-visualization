{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "lib": ["ESNext", "DOM"],
    "outDir": "./dist",
    "skipLibCheck": true
  },
  "include": ["src"]
}
